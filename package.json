    "fallow": "bunx --bun fallow",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:unsafe": "biome check --write --unsafe .",
    "lint:write": "biome check --write .",
    "shadcn": "bunx --bun shadcn@latest",
